# Development / demo configuration.
# Copy to .env and start the stack:  cp .env.example .env && docker compose up -d --build
#
# The values below are throwaway credentials for a local machine. For anything reachable from a
# network, start from .env.production.example instead — it has no usable values at all.

# Base URL the browser uses. Must match EXTERNAL_HOSTNAME below.
# Use https://mish (and add "127.0.0.1 mish" to your hosts file) to mirror the production hostname.
EXTERNAL_BASE_URL=https://localhost
EXTERNAL_HOSTNAME=localhost

HTTP_PORT=80
HTTPS_PORT=443

MONGO_USER=mish
MONGO_PASSWORD=local-dev-only-mongo
MONGO_DB=mish-db

# Development start command: dev mode plus the demo realms in infra/keycloak/realms.
KEYCLOAK_COMMAND=start-dev --import-realm --http-relative-path=/auth

KEYCLOAK_REALM=mock-realm
KEYCLOAK_CLIENT_ID=dev-client
# Must match the client secret in infra/keycloak/realms/mock-realm.json.
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-admin
KEYCLOAK_DB_PASSWORD=local-dev-only-keycloak-db
