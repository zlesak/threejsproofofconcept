# Production configuration template.
# Copy to .env on the server and fill in every value. Nothing here has a default: the stack refuses
# to start with a blank or missing value rather than falling back to something guessable.
#
# Generate each secret separately, for example:
#   openssl rand -base64 32
#
# Keep the finished .env out of version control (infra/.env is already gitignored) and readable only
# by the account that runs Docker:  chmod 600 .env

# --- Public address -----------------------------------------------------------------------------
# The hostname the browser uses. It must resolve to this machine and match the TLS certificate.
EXTERNAL_BASE_URL=https://mish.example.org
EXTERNAL_HOSTNAME=mish.example.org

HTTP_PORT=80
HTTPS_PORT=443

# --- Database -----------------------------------------------------------------------------------
# MongoDB is never published outside the Docker network; this password protects it from other
# containers on the same host.
MONGO_USER=mish
MONGO_PASSWORD=
MONGO_DB=mish-db

# --- Identity provider --------------------------------------------------------------------------
# Create a dedicated realm and a confidential client in Keycloak, then paste its secret here.
# Do not reuse the bundled mock-realm: it ships with known users and a known client secret.
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Keycloak's own administrator. Used only to sign in to the admin console.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Password of the PostgreSQL database behind Keycloak.
KEYCLOAK_DB_PASSWORD=

# --- Before going live --------------------------------------------------------------------------
# 1. Replace the self-signed certificate in the gateway-certs volume with a real one
#    (Let's Encrypt or your institution's certificate). See infra/README.md.
# 2. Remove infra/keycloak/realms/*.json from the deployment, or the demo users would be imported
#    on a fresh Keycloak database.
# 3. Take a backup of the mongo-data volume; it holds every chapter, quiz and uploaded model.
